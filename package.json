{
  "name": "novatech-sentinel",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:v24": "eslint src/sentinel src/enterprise src/main.tsx",
    "test": "npm run test:v2 && npm run test:sentinel && npm run test:enterprise && npm run test:mac && npm run test:remote && npm run test:companion",
    "test:v2": "node --experimental-strip-types tests/v2-all.test.mjs",
    "test:sentinel": "node --experimental-strip-types --test tests/sentinel-*.test.mjs",
    "test:enterprise": "node --experimental-strip-types --test tests/enterprise-demo.test.mjs",
    "test:mac": "node --experimental-strip-types --test tests/mac-helper.test.mjs",
    "test:remote": "node --experimental-strip-types --test tests/remote-pairing.test.mjs",
    "test:companion": "node --experimental-strip-types --test tests/mac-approval.test.mjs",
    "helper:mac": "node scripts/mac-control-helper.mjs",
    "helper:mac:live": "node scripts/mac-control-helper.mjs --live",
    "remote:preview": "node scripts/remote-agent.mjs",
    "remote:live": "node scripts/remote-agent.mjs --live",
    "remote:install:preview": "node scripts/remote-agent-launch.mjs install-preview",
    "remote:install:live": "node scripts/remote-agent-launch.mjs install-live",
    "remote:uninstall": "node scripts/remote-agent-launch.mjs uninstall",
    "companion:build": "node scripts/companion-build.mjs",
    "companion:test-dialog": "node scripts/companion-test-dialog.mjs",
    "preview": "vite preview",
    "script:export": "node --experimental-strip-types scripts/export-demo-script.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/geist-mono": "^5.1.0",
    "@fontsource/geist-sans": "^5.1.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10"
  },
  "description": "NOVATECH Sentinel V2.4 \u2014 unified enterprise risk command platform (ESAIP Group 1). Web demo runs on simulated data; physical Mac action needs the separate local companion."
}
